{
  "name": "fpv-drone-simulator",
  "version": "0.1.0",
  "description": "Comprehensive FPV drone simulator and pilot-training platform with Betaflight-compatible flight controller, realistic quadcopter physics, transmitter/gamepad support, high-quality 3D graphics, FPV camera presentation, structured training, telemetry/recording, racing/freestyle/multiplayer, persistent profiles",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext ts,tsx --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,md}\"",
    "typecheck": "tsc --noEmit",
    "worker:build": "vite build --config vite.worker.config.ts",
    "docs:generate": "typedoc --out docs/api src"
  },
  "keywords": [
    "fpv",
    "drone",
    "simulator",
    "betaflight",
    "webgpu",
    "webgl",
    "physics",
    "flight-controller",
    "training",
    "multiplayer"
  ],
  "author": "Marcus Vance <marcus.vance@rexbondan.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BobHenryWbDv/fpv-drone-simulator.git"
  },
  "bugs": {
    "url": "https://github.com/BobHenryWbDv/fpv-drone-simulator/issues"
  },
  "homepage": "https://github.com/BobHenryWbDv/fpv-drone-simulator#readme",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "gl-matrix": "^3.4.3",
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@types/web": "^0.0.162",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^0.20.0",
    "vitest": "^2.0.0",
    "workbox-window": "^7.1.0"
  },
  "pwa": {
    "registerType": "autoUpdate",
    "includeAssets": ["favicon.ico", "robots.txt"],
    "manifest": {
      "name": "FPV Drone Simulator",
      "short_name": "FPV Sim",
      "description": "Browser-based FPV drone simulator with Betaflight-compatible flight controller",
      "theme_color": "#0f172a",
      "background_color": "#0f172a",
      "display": "fullscreen",
      "orientation": "landscape-primary",
      "scope": "/",
      "start_url": "/",
      "icons": [
        {
          "src": "/assets/icons/icon-72.png",
          "sizes": "72x72",
          "type": "image/png"
        },
        {
          "src": "/assets/icons/icon-96.png",
          "sizes": "96x96",
          "type": "image/png"
        },
        {
          "src": "/assets/icons/icon-128.png",
          "sizes": "128x128",
          "type": "image/png"
        },
        {
          "src": "/assets/icons/icon-144.png",
          "sizes": "144x144",
          "type": "image/png"
        },
        {
          "src": "/assets/icons/icon-152.png",
          "sizes": "152x152",
          "type": "image/png"
        },
        {
          "src": "/assets/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any maskable"
        },
        {
          "src": "/assets/icons/icon-384.png",
          "sizes": "384x384",
          "type": "image/png"
        },
        {
          "src": "/assets/icons/icon-512.png",
          "sizes": "512x512",
          "type": "image/png",
          "purpose": "any maskable"
        }
      ]
    }
  }
}